{
  "manifest_version": 3,
  "name": "AdVanish — Ad & Tracker Blocker",
  "short_name": "AdVanish",
  "version": "1.0.0",
  "description": "Ruthlessly blocks ads, trackers and pop-ups, auto-skips YouTube ads, and removes anti-adblock nags. Fast, private, zero data collection.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
    "default_title": "AdVanish — click to pause/resume"
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "ads", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content-youtube.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-cosmetic.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
