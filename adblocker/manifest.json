{
  "manifest_version": 3,
  "name": "NoAds Ad Blocker Agent",
  "short_name": "NoAds",
  "version": "1.5.4",
  "description": "Block ads, trackers and pop-ups, skip YouTube ads automatically, and remove anti-adblock nags. Fast, private, zero data collection.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "NoAds — click to pause/resume"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "yt-adfree.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-cosmetic.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}