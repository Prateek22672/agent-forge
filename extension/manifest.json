{
  "manifest_version": 3,
  "name": "AgentFury",
  "short_name": "AgentFury",
  "description": "Agent Fury: AI agent & assistant in your browser — ask about any text you select, write & fix email in Gmail, plus reminders.",
  "version": "1.18.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AgentFury — click to open the side panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-privacy": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Privacy mode — hide/show AgentFury's on-page UI everywhere"
    },
    "open-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open the AgentFury side panel (and warm up the server)"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity",
    "alarms",
    "notifications",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "https://agentfury.foliofyx.in/*",
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content-gmail.js"
      ],
      "css": [
        "content-gmail.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-global.js"
      ],
      "run_at": "document_idle"
    }
  ]
}