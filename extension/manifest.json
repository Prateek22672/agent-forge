{
  "manifest_version": 3,
  "name": "AgentFury",
  "short_name": "AgentFury",
  "description": "Your AI agent in the browser — priority inbox, reminders, and an AI writer/corrector inside Gmail compose.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AgentFury"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "identity"],
  "host_permissions": [
    "https://agentfury.foliofyx.in/*",
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content-gmail.js"],
      "css": ["content-gmail.css"],
      "run_at": "document_idle"
    }
  ]
}
